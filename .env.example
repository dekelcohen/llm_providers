# Copy to .env (gitignored) in the directory you run from, or export in the shell. Never commit real values.
OPENROUTER_API_KEY=
# AWS Bedrock (boto3): uses your AWS profile / SSO session
AWS_REGION=eu-central-1
AWS_PROFILE=
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_GUARDRAIL_ID=
AWS_BEDROCK_GUARDRAIL_VERSION=
# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=
# Gemini
GEMINI_API_KEY=
